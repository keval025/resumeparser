# Copy this file to .env and fill in your values:   copy .env.example .env
# NEVER commit .env (it is in .gitignore). On Render, set these in the service's Environment tab.
#
# Two ways to run:
#   * Local, single user (default): leave the SUPABASE_* lines empty -> no login, SQLite, files in data/.
#   * Multi-user web app: fill in DATABASE_URL + SUPABASE_* (see DEPLOY.md) and set APP_ENV=production.

# --- App ---
# development | production ("production" refuses to start without Supabase + Postgres)
APP_ENV=development
# Public address of the app, no trailing slash. Locally: http://127.0.0.1:8000
APP_BASE_URL=http://127.0.0.1:8000
APP_NAME=Resume Parser
# Shown on the Privacy Policy and Terms pages - replace before launch.
COMPANY_NAME=[Your Company Name]
CONTACT_EMAIL=privacy@example.com
# Extra allowed browser origins (comma separated), e.g. a custom domain: https://www.example.com
CORS_ORIGINS=

# --- Database ---
# Local default: SQLite in data/resumes.db.
# Production: Supabase -> Project -> Connect -> "Session pooler" URI (port 5432), with your DB password:
# DATABASE_URL=postgresql://postgres.abcdefghijklmnop:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Supabase (login + private file storage) ---
# Supabase -> Project Settings -> API (Data API / API Keys).
SUPABASE_URL=
# The "anon" / publishable key: safe for browsers.
SUPABASE_ANON_KEY=
# The "service_role" / secret key: SERVER ONLY. Never put it in frontend code or share it.
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings -> JWT Keys -> "Legacy JWT secret". Optional if your project uses JWT signing keys (JWKS).
SUPABASE_JWT_SECRET=

# --- Google Gemini ---
# Get a key at https://aistudio.google.com/apikey . For a public app use a key with billing enabled:
# on the free tier Google may use submitted content (your users' resumes) to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Gemini models "think" before answering; thinking counts toward this limit.
GEMINI_MAX_OUTPUT_TOKENS=32768
LLM_PROVIDER=gemini
# Resumes shorter than this (characters) use ONE LLM call; longer ones use one call per section.
LLM_SINGLE_CALL_MAX_CHARS=12000

# --- Free plan limits per calendar month (plan "pro" = unlimited) ---
FREE_PARSES_PER_MONTH=5
FREE_MATCHES_PER_MONTH=10
FREE_TAILORS_PER_MONTH=3
FREE_COMPARISONS_PER_MONTH=2
# Per-user request rate limits. "Heavy" = requests that start AI work, render files or fetch URLs.
RATE_LIMIT_HEAVY=20/minute
RATE_LIMIT_DEFAULT=120/minute

# --- Uploads ---
MAX_FILE_MB=10
MAX_PDF_PAGES=10
# Download links (exports, original PDFs) expire after this many seconds.
SIGNED_URL_SECONDS=600

# --- Local-mode storage (ignored when Supabase is configured) ---
# STORAGE_DIR=data/storage
# UPLOAD_DIR=data/uploads/api
# OUTPUT_DIR=data/output

# --- Error tracking (optional): sentry.io -> Project -> Client Keys (DSN) ---
SENTRY_DSN=

# --- OCR for scanned PDFs (Windows: set these if the programs are not on PATH) ---
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# POPPLER_PATH=C:\poppler\Library\bin
OCR_MIN_CHARS=50
OCR_DPI=300

# --- Validation ---
GROUNDING_THRESHOLD=85
REVIEW_THRESHOLD=0.7

# --- Job match (Resume <-> JD) ---
# rapidfuzz score (0-100) above which a differently spelled JD skill counts as present.
MATCH_FUZZY_THRESHOLD=85
# Optional informational metric (NOT part of the score): cosine similarity of Gemini embeddings.
MATCH_SEMANTIC_SIMILARITY=true
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Compare Jobs ---
# Jobs scored against Gemini at the same time (all comparisons together).
COMPARE_CONCURRENCY=3
# Attempts per job on Gemini rate-limit / 5xx errors; waits 2 s, 4 s, 8 s... in between.
COMPARE_RETRY_ATTEMPTS=4
COMPARE_RETRY_BASE_DELAY=2

# --- Daily clean-up job (resume auto-delete, old exports) ---
ENABLE_SCHEDULER=true

LOG_LEVEL=INFO
